{
  "name": "vite-swc-ts",
  "private": true,
  "version": "8.57.1",
  "type": "module",
  "description": "React boilerplate with Vite SWC",
  "author": "Hoang Cong Phan <hoangcp219@gmail.com>",
  "keywords": [
    "vite",
    "swc",
    "react",
    "typescript",
    "tailwindcss",
    "eslint",
    "prettier",
    "husky",
    "hygen"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --open",
    "build": "tsc && vite build",
    "type-check": "tsc --pretty --noEmit",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,tsx,json}",
    "prettier": "prettier --write src/**/*.{ts,tsx,css,json}",
    "gen:component": "hygen components new",
    "gen:page": "hygen pages new",
    "gen:container": "hygen containers new",
    "prepare": "husky install"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.11.1",
    "@types/node": "^18.16.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "hygen": "^6.2.11",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.23",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.0.5",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.7",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
